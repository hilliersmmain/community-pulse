{
  "data": [
    {
      "hovertemplate": "<b>Month:</b> %{x}<br><b>New Members:</b> %{y}<br><b>Cumulative:</b> %{customdata}<br><extra></extra>",
      "line": {
        "color": "#0072B2",
        "width": 3
      },
      "marker": {
        "color": "#0072B2",
        "size": 8
      },
      "mode": "lines+markers",
      "name": "New Members",
      "type": "scatter"
    },
    {
      "hovertemplate": "<b>Trend:</b> %{y:.1f}<extra></extra>",
      "line": {
        "color": "#D55E00",
        "dash": "dash",
        "width": 2
      },
      "mode": "lines",
      "name": "Trend Line",
      "type": "scatter"
    }
  ],
  "layout": {
    "annotations": [
      {
        "font": {
          "color": "gray",
          "size": 12
        },
        "showarrow": false,
        "text": "Mean: 8.0 | Median: 8.0 | Total: 199",
        "x": 0.5,
        "xanchor": "left",
        "xref": "paper",
        "y": -0.15,
        "yanchor": "middle",
        "yref": "paper"
      }
    ],
    "hovermode": "x unified",
    "legend": {
      "x": 0.01,
      "xanchor": "left",
      "y": 0.99,
      "yanchor": "top"
    },
    "modebar": {
      "add": [
        "toImage"
      ]
    },
    "plot_bgcolor": "rgba(240, 240, 240, 0.5)",
    "shapes": [
      {
        "line": {
          "color": "#009E73",
          "dash": "dot"
        },
        "type": "line",
        "x0": 0,
        "x1": 1,
        "xref": "x domain",
        "y0": 7.96,
        "y1": 7.96,
        "yref": "y"
      }
    ],
    "showlegend": true,
    "title": {
      "text": "Membership Growth Over Time<br><sub>Data State: Cleaned | Total Members: 206</sub>",
      "x": 0.5,
      "xanchor": "center"
    },
    "xaxis": {
      "title": {
        "text": "Month (YYYY-MM)"
      }
    },
    "yaxis": {
      "title": {
        "text": "Number of New Members Joined"
      }
    }
  }
}